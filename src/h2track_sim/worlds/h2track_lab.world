<?xml version="1.0"?>
<!-- baseline scene canonical world; kept in sync with scenes/baseline/h2track_lab.world -->
<sdf version="1.6">
  <world name="h2track_lab">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.9 0.9 0.95 1.0</background>
      <shadows>true</shadows>
